# Telegram Bot Token (von @BotFather)
TELEGRAM_BOT_TOKEN=

# Anthropic API Key
ANTHROPIC_API_KEY=

# Uhrzeit des automatischen Tagesberichts (24h Format, z.B. 21:00)
REPORT_HOUR=21
REPORT_MINUTE=0

# Zeitzone
TZ=Europe/Berlin

# Microsoft Graph API (Azure App Registration)
# Anleitung: Azure Portal → App Registrations → New Registration
# Berechtigungen: Files.ReadWrite.All (Application)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# SharePoint / OneDrive Konfiguration
# Drive ID ermitteln: GET https://graph.microsoft.com/v1.0/sites/{siteId}/drives
SHAREPOINT_DRIVE_ID=
# Root-Ordner in SharePoint (wird automatisch erstellt)
SHAREPOINT_ROOT_FOLDER=Bautagesberichte
